<?xml version="1.0"?>
<sdf version="1.9">
  <model name="go2_edu">
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial>
        <mass>9.0</mass>
        <inertia><ixx>0.095</ixx><iyy>0.31</iyy><izz>0.34</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body_collision"><geometry><box><size>0.62 0.28 0.18</size></box></geometry></collision>
      <visual name="body_visual">
        <geometry><box><size>0.62 0.28 0.18</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.16 0.16 0.16 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="top_shell">
        <pose>0 0 0.105 0 0 0</pose><geometry><box><size>0.42 0.24 0.04</size></box></geometry>
        <material><ambient>0.88 0.62 0.08 1</ambient><diffuse>0.88 0.62 0.08 1</diffuse></material>
      </visual>
      <visual name="head">
        <pose>0.345 0 0.005 0 0 0</pose><geometry><box><size>0.09 0.24 0.15</size></box></geometry>
        <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material>
      </visual>
      <visual name="camera_lens">
        <pose>0.394 0 0.025 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse></material>
      </visual>
      <visual name="lidar_visual">
        <pose>0.255 0 0.145 0 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.055</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>200</update_rate></sensor>
      <sensor name="front_camera" type="camera">
        <pose>0.397 0 0.025 0 0 0</pose><always_on>true</always_on><update_rate>30</update_rate>
        <topic>/go2/front_camera</topic>
        <camera><horizontal_fov>1.396</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>50</far></clip></camera>
      </sensor>
      <sensor name="utlidar" type="gpu_lidar">
        <pose>0.255 0 0.175 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/go2/lidar</topic>
        <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.05</min><max>30</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>

