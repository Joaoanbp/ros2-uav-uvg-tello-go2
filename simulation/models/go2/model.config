<?xml version="1.0"?>
<model>
  <name>Unitree Go2 EDU (research approximation)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>UVG UAV/UGV simulation</name></author>
  <description>
    Articulated 12-DOF quadruped model with IMU, front camera and lidar sensors.
    Geometry and inertial values are suitable for integration work, not system
    identification or controller validation against the physical Go2 EDU.
  </description>
</model>
