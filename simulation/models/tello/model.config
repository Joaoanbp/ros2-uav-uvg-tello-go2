<?xml version="1.0"?>
<model>
  <name>DJI Tello (research approximation)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>UVG UAV/UGV simulation</name>
  </author>
  <description>
    Lightweight quadrotor model shaped and parameterized approximately like a
    DJI Tello. It exposes an IMU and uses the ArduPilot JSON plugin on UDP 9002.
  </description>
</model>
