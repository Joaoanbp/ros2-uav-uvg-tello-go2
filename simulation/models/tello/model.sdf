<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tello">
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00011</ixx><iyy>0.00011</iyy><izz>0.00020</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.10 0.085 0.035</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.10 0.085 0.035</size></box></geometry>
        <material>
          <ambient>0.92 0.92 0.92 1</ambient>
          <diffuse>0.92 0.92 0.92 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="nose_visual">
        <pose>0.052 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.0425</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="camera_visual">
        <pose>0.059 0 -0.002 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
      </sensor>
      <!-- Synthetic front RGB-D and downward RGB; not calibrated Tello optics.
           Gazebo cameras look along +X; positive pitch points toward the ground. -->
      <sensor name="front_camera" type="rgbd_camera">
        <pose>0.065 0 -0.002 0 0.436332 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/tello/camera/front</topic>
        <camera>
          <camera_info_topic>/tello/camera/front/camera_info</camera_info_topic>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>50</far></clip>
        </camera>
      </sensor>
      <sensor name="down_camera" type="camera">
        <pose>0 0 -0.025 0 1.570796327 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/tello/camera/down/image</topic>
        <camera>
          <camera_info_topic>/tello/camera/down/camera_info</camera_info_topic>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>50</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- The four motor pods and arms are fixed to the central body. -->
    <link name="frame">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.008</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="front_arm"><pose>0.055 0 0 0 0 0</pose><geometry><box><size>0.10 0.018 0.012</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      <visual name="rear_arm"><pose>-0.055 0 0 0 0 0</pose><geometry><box><size>0.10 0.018 0.012</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="left_arm"><pose>0 0.055 0 0 0 0</pose><geometry><box><size>0.018 0.10 0.012</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      <visual name="right_arm"><pose>0 -0.055 0 0 0 0</pose><geometry><box><size>0.018 0.10 0.012</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
    </link>
    <joint name="frame_joint" type="fixed"><parent>base_link</parent><child>frame</child></joint>

    <!-- Rotor order matches ArduPilot's gazebo-iris frame: FR, RL, FL, RR. -->
    <link name="rotor_0">
      <pose>0.085 -0.085 0.018 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><box><size>0.12 0.008 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 0.75</ambient><diffuse>0.15 0.15 0.15 0.75</diffuse></material></visual>
      <collision name="hub"><geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry></collision>
    </link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00004</damping></dynamics></axis></joint>
    <link name="rotor_1">
      <pose>-0.085 0.085 0.018 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><box><size>0.12 0.008 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 0.75</ambient><diffuse>0.15 0.15 0.15 0.75</diffuse></material></visual>
      <collision name="hub"><geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry></collision>
    </link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00004</damping></dynamics></axis></joint>
    <link name="rotor_2">
      <pose>0.085 0.085 0.018 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><box><size>0.12 0.008 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 0.75</ambient><diffuse>0.15 0.15 0.15 0.75</diffuse></material></visual>
      <collision name="hub"><geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry></collision>
    </link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00004</damping></dynamics></axis></joint>
    <link name="rotor_3">
      <pose>-0.085 -0.085 0.018 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="prop"><geometry><box><size>0.12 0.008 0.002</size></box></geometry><material><ambient>0.15 0.15 0.15 0.75</ambient><diffuse>0.15 0.15 0.15 0.75</diffuse></material></visual>
      <collision name="hub"><geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry></collision>
    </link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.00004</damping></dynamics></axis></joint>

    <!-- Two blade lift surfaces per rotor. Values are deliberately conservative
         and should be identified against flight data before control research. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.04 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.04 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_0</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.04 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.04 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.04 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.04 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>0.04 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3</link_name></plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag"><a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0</cma><cla_stall>-0.025</cla_stall><cda_stall>0</cda_stall><cma_stall>0</cma_stall><area>0.00045</area><air_density>1.2041</air_density><cp>-0.04 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3</link_name></plugin>

    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_0_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_joint</joint_name></plugin>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>base_link::imu_sensor</imuName>
      <control channel="0"><jointName>rotor_0_joint</jointName><useForce>1</useForce><multiplier>2500</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.01</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.25</cmd_max><cmd_min>-0.25</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      <control channel="1"><jointName>rotor_1_joint</jointName><useForce>1</useForce><multiplier>2500</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.01</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.25</cmd_max><cmd_min>-0.25</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      <control channel="2"><jointName>rotor_2_joint</jointName><useForce>1</useForce><multiplier>-2500</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.01</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.25</cmd_max><cmd_min>-0.25</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      <control channel="3"><jointName>rotor_3_joint</jointName><useForce>1</useForce><multiplier>-2500</multiplier><offset>0</offset><servo_min>1100</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.01</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>0.25</cmd_max><cmd_min>-0.25</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
    </plugin>
  </model>
</sdf>
